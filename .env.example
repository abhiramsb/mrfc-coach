DISCORD_TOKEN=
# LLM for the coach. Free options: gemini (default), groq, openrouter.
# Paid Claude: LLM_PROVIDER=anthropic and put the Anthropic key in LLM_API_KEY.
LLM_PROVIDER=gemini
LLM_API_KEY=
# optional: override the default model (check your provider's current free models)
LLM_MODEL=
# required: MRFC Academy's EA club ID (the old club's ID no longer applies)
CLUB_ID=
PLATFORM=common-gen5
# optional: channel for the daily debrief, i.e. #mrfc-tactics (posted 03:00 in COACH_TZ)
COACH_CHANNEL_ID=
COACH_TZ=Asia/Kolkata
# persistent folder for the limit cache (so restarts don't reset cooldowns)
DATA_DIR=.
# private channel where the bot stores its memory file (history, targets, cooldowns).
# Give the bot View Channel, Send Messages, Attach Files, Read Message History.
DATA_CHANNEL_ID=
# set to 1 for one start to clear cooldowns/cached reports, then remove it
CLEAR_CACHE=
# role allowed to run /coach and /coachplayer (the bot's Discord application owner is always allowed, with no limits)
CAPTAIN_ROLE=MRFC Captain
